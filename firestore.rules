rules_version = '2';

// Petpulse — Firestore Security Rules
//
// Data model these rules protect:
//   users/{uid}/pets/{petId}                          private pet profiles
//   users/{uid}/pets/{petId}/vaccinations/{docId}     private vaccination records
//   users/{uid}/pets/{petId}/medical_reports/{docId}  private medical reports
//   lost_pet_alerts/{alertId}                         community lost-pet feed
//
// Principle: your own pet & health data is visible ONLY to you.
// Everything not explicitly matched above is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Private per-user data ----------
    match /users/{uid} {
      // A signed-in user can read and write ONLY their own profile document.
      allow read, write: if isOwner(uid);

      match /pets/{petId} {
        allow read, write: if isOwner(uid);

        // Vaccinations and medical reports nested under each pet.
        match /{subcollection}/{docId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // ---------- Community lost-pet alerts ----------
    match /lost_pet_alerts/{alertId} {
      // Any signed-in user can browse the alerts feed.
      allow read: if isSignedIn();

      // Any signed-in user can post an alert, but must own it and
      // include the required fields (see helper below).
      allow create: if isSignedIn() && alertIsWellFormed();

      // Only the owner can edit or take down an alert. Requires the
      // document to have an "ownerId" field equal to the writer's uid.
      allow update, delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ---------- Everything else: deny by default ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function alertIsWellFormed() {
      return request.resource.data.keys().hasAll(
               ['petName', 'species', 'lastSeenLocation', 'contactPhone', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.petName is string
        && request.resource.data.species is string
        && request.resource.data.lastSeenLocation is string
        && request.resource.data.contactPhone is string;
    }
  }
}
