rules_version = '2';

// Petpulse / Wagmiya Firestore Security Rules
// Recovery build: full v10 base PLUS pet_tags, tag_scans, partner_ledger,
// and the corrected rules for lost_pet_alerts, found_reports, orders,
// bookings and isAdmin().
//
// Every rule below was checked against the fields the app actually writes
// (app/src/main/java/com/example/... and public/p/index.html).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins: SINGLE source of truth - the `admins/{email}` identity document.
    // This mirrors exactly what the app reads in
    // FirestoreCommerceRepository.observeIsAdmin() (db.collection("admins")
    // .document(email)). The previous hard-coded email allow-list
    // ('jithurenjith1@gmail.com' / 'itspetpulse@gmail.com') was a SECOND,
    // competing definition of "admin" and has been removed so the two can never
    // drift. This is NOT a weakening: writes to `admins/*` are fully denied
    // below (allow write: if false), so the admin set can only be changed from
    // the Firebase console - the same trust boundary as before. The null guard
    // and case-insensitive match are kept (the app lowercases the email before
    // using it as a doc id).
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // ---------- users: own pets, vaccinations, certificates, medical reports ----------
    // CHANGED (audit FIX 2 / CRITICAL): the paid-plan gating fields on the owner's
    // own profile document (`carePlan` and `carePlanUntil`) are now ADMIN-ONLY.
    // The owner keeps full read/write of their profile EXCEPT those two fields:
    // an update is allowed only while both values are unchanged (the app copies
    // the existing value straight back in saveCustomerProfile(), so ordinary
    // profile saves still pass). A brand-new profile may be created only with the
    // free defaults (carePlan == "" and carePlanUntil == 0). This closes the
    // self-grant: a user can no longer write carePlan = "premium" on their own
    // document to unlock the 15% discount / free delivery.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['carePlan'])
            || request.resource.data.carePlan == '')
        && (!request.resource.data.keys().hasAny(['carePlanUntil'])
            || request.resource.data.carePlanUntil == 0);

      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.get('carePlan', '') == resource.data.get('carePlan', '')
            && request.resource.data.get('carePlanUntil', 0) == resource.data.get('carePlanUntil', 0));

      allow delete: if isSignedIn() && request.auth.uid == uid;

      match /pets/{petId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;

        match /{sub=**} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    // ---------- admins: identity check doc, nobody writes ----------
    // Read matched case-insensitively because the app reads admins/{email}
    // with a lowercased email. Writes remain fully denied.
    match /admins/{email} {
      allow read: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email.lower();
      allow write: if false;
    }

    // ---------- lost pet SOS alerts ----------
    // CHANGED: read is now signed-in only (documents hold the owner's phone
    // numbers, so they must NOT be world-readable). CHANGED: create now
    // requires the real field set the app writes (postSosAlert() in
    // LostPetAlertPoster.kt and submitLostPetAlert() in
    // FirestoreCommerceRepository.kt) and binds ownerId to the caller.
    match /lost_pet_alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['ownerId', 'petName', 'species', 'lastSeenLocation', 'contactPhone'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.petName is string
        && request.resource.data.species is string
        && request.resource.data.lastSeenLocation is string
        && request.resource.data.contactPhone is string;
      // Admin moderates alerts (the app moderates alerts solely from the admin
      // screen). The owner may also DELETE their own alert: deleteAllUserData()
      // in FirestorePetRepository queries lost_pet_alerts by ownerId and deletes
      // each match, so account deletion fails without this owner-delete rule.
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- market listings (pets listed by users; admin can moderate) ----------
    // CHANGED (audit FIX 1 / CRITICAL): read was `if true` (world-readable).
    // Each listing carries the seller's sellerPhone / sellerName / city, so it
    // is now signed-in only. create / update / delete are unchanged.
    match /market_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- shop products (admin managed catalogue) ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- delivery dealers (admin managed) ----------
    match /dealers/{dealerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- orders (COD marketplace orders) ----------
    // CHANGED: create now binds ownerId to the caller (placeOrder() writes
    // ownerId = auth.currentUser.uid).
    // CHANGED (audit FIX 1): the owner may NO LONGER update arbitrary fields of
    // their own order. A customer's only legitimate change is to cancel it, so
    // the owner may touch exactly ONE field - `status` - and only set it to
    // "CANCELLED". Everything else (status -> ASSIGNED/DELIVERED, totalInr,
    // discountInr, items, address, dealerName/dealerPhone, ...) is admin-only.
    // This blocks self-marking an order DELIVERED, editing the total, or
    // clearing the dealer assignment. Admin keeps full update.
    match /orders/{orderId} {
      // The buyer's REAL paid plan, read from their own profile document.
      // `exists()` guards the get(): get() returns null for a missing document
      // and drilling into `.data` on null makes the whole rule error out, so a
      // missing profile document must be treated as the free plan, not an error.
      // `.get('carePlan', '')` keeps a missing FIELD safe too.
      function buyerPlan() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('carePlan', '')
          : '';
      }

      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      // create now ALSO validates the money fields against the buyer's real
      // plan, so a modified client cannot self-grant a discount (or a bogus
      // total). Ownership check is preserved.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'totalInr', 'discountInr'])
        && request.resource.data.totalInr is number
        && request.resource.data.discountInr is number
        && request.resource.data.discountInr >= 0
        && request.resource.data.totalInr >= 0
        // EXACT: a discount is only ever legitimate for a real Care/Premium plan.
        && (request.resource.data.discountInr == 0
            || buyerPlan() in ['care', 'premium'])
        // APPROXIMATE: the order document stores neither subtotalInr nor
        // deliveryFeeInr, so the exact per-plan percentage (10%/15% of the
        // subtotal) cannot be recomputed here. This is the strongest SAFE bound
        // that uses the stored totalInr: every genuine order (0/10/15% + a
        // non-negative fee) satisfies discountInr <= 0.18 * totalInr.
        && request.resource.data.discountInr * 100 <= request.resource.data.totalInr * 18;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'CANCELLED');
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- service bookings (doctor / trainer / grooming) ----------
    // CHANGED: create now binds ownerId to the caller (placeBooking() writes
    // ownerId = auth.currentUser.uid).
    // CHANGED (audit FIX 1): the owner may NO LONGER update arbitrary fields of
    // their own booking. The only customer-side status change the app performs
    // is markBookingReceived() -> "COMPLETED" (plus a customer cancel), so the
    // owner may touch exactly ONE field - `status` - and only set it to
    // "COMPLETED" or "CANCELLED". Everything else (status -> CONFIRMED,
    // assignedName/assignedPhone, feeInr, ...) is admin-only. Admin keeps full
    // update.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['COMPLETED', 'CANCELLED']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- vet partners (admin managed) ----------
    match /vets/{vetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- community posts ----------
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---------- support tickets (v8: users report problems, admin reads/resolves) ----------
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['category', 'subject', 'details', 'contact']);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- animal rescue reports (v8: users report, admin coordinates rescue) ----------
    match /rescue_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['animalType', 'description', 'location', 'contact']);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- partner applications (v9: users apply, admin reviews) ----------
    // Unchanged: submitPartnerApplication() writes no owner field, so create
    // stays isSignedIn() only.
    match /partner_applications/{appId} {
      allow create: if isSignedIn();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- found pet sighting reports (v10: users report, admin connects) ----------
    // CHANGED: read is now admin-only (documents hold the finder's phone number).
    // CHANGED (Round 3): the LOST-PET OWNER may also read a sighting report that
    // belongs to THEIR OWN alert, so the owner finally sees that someone spotted
    // their pet. The report carries `alertId` (written by submitFoundReport()) and
    // the alert carries `ownerId` (written by postSosAlert() / submitLostPetAlert()),
    // so the rule reads the linked alert with get() and compares ownerId to the
    // caller. exists() guards the get() so a missing alert denies cleanly instead
    // of erroring on a null document, and alertId is checked to be a non-empty
    // string FIRST so the document path is always well-formed. This stays strictly
    // owner-scoped: nothing is publicly readable.
    match /found_reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.alertId is string
            && resource.data.alertId != ''
            && exists(/databases/$(database)/documents/lost_pet_alerts/$(resource.data.alertId))
            && get(/databases/$(database)/documents/lost_pet_alerts/$(resource.data.alertId)).data.get('ownerId', '') == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ---------- pet tags (public lost-pet tag page; ADDED) ----------
    // Public single-document get (never list), owner-only create/update/delete.
    // ensurePetTag() writes ownerUid; setTagLost() updates the "lost" flag.
    match /pet_tags/{tagId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- tag scans ("someone scanned your tag" pings; ADDED) ----------
    // Public create from the QR web page (no sign-in) with strict field checks,
    // owner-only read and owner-only delete, no update. Page writes:
    // publicId, ownerUid, createdAt (+ optional message, lat, lng).
    match /tag_scans/{scanId} {
      allow create: if request.resource.data.keys().hasAll(['publicId', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['publicId', 'ownerUid', 'createdAt', 'message', 'lat', 'lng'])
        && request.resource.data.publicId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.createdAt is number
        && request.resource.data.publicId.size() <= 128
        && request.resource.data.ownerUid.size() <= 128
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 1000));
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      // Owner may DELETE their own scans: deleteAllUserData() queries tag_scans
      // by ownerUid and deletes each match. There is no update.
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- partner ledger (admin commission tracking; ADDED) ----------
    // Admin-only read and write.
    match /partner_ledger/{entryId} {
      allow read, write: if isAdmin();
    }

    // ---------- news posts (admin-managed announcements; ADDED) ----------
    // Public read (news articles), admin-only write. This block had been
    // mis-placed INSIDE the tag_scans create rule, which made the whole
    // ruleset fail to parse; it is restored here as a top-level match, kept
    // BEFORE the catch-all so the catch-all stays last.
    match /news_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- reviews (product + dealer ratings) ----------
    // Public read (the ratings UI lists every review). A signed-in user may
    // create ONE review carrying exactly the field set addReview() writes
    // (FirestoreCommerceRepository.addReview()) with ownerId bound to the
    // caller and rating an integer 1..5. Only an admin may delete a review
    // (AdminScreen ReviewsAdminTab -> deleteReview). Reviews are immutable:
    // there is no update. This block was MISSING before, so the catch-all
    // denied the whole ratings feature.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['productId','dealerName','ownerId','authorName','rating','text','orderId','createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        // DELIVERED-ORDER GATE (audit FIX 1): a review may only be created for an
        // order that really belongs to the caller AND is DELIVERED, not merely
        // for a product the client claims to own. The review document already
        // carries orderId, so get() reads that single order document. orderId is
        // checked to be a non-empty string FIRST so the document path is always
        // well-formed, and exists() guards the get() so a MISSING order denies
        // cleanly (false) instead of erroring on a null document.
        && request.resource.data.orderId is string
        && request.resource.data.orderId != ''
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('ownerId', '') == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('status', '') == 'DELIVERED';
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---------- adminLog (admin audit trail for soft-archive actions; ADDED) ----------
    // Admin-only read and write. The app writes one entry every time an admin
    // archives (or deletes) an order / booking - see
    // FirestoreCommerceRepository.writeAdminLog(). Fields written by the app:
    // actorUid, actorEmail, action, targetType, targetId, at (epoch millis).
    match /adminLog/{entryId} {
      allow read, write: if isAdmin();
    }

    // ---------- reports (user-submitted content reports; ADDED) ----------
    // A signed-in user may CREATE one report per target, bound to their own uid.
    // The document id is deterministic: "{targetType}_{targetId}_{reporterUid}",
    // so a repeat report by the same user for the same target lands on the SAME
    // document - which is an update - and is DENIED here (update is false). That
    // enforces exactly one report per user per target without any extra read.
    // Admin-only read and delete; there is NO public read and no update.
    // Fields written by the app: reporterUid, targetType, targetId, reason,
    // createdAt (epoch millis).
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['reporterUid', 'targetType', 'targetId', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.reason is string
        && request.resource.data.createdAt is number;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- everything else: denied (MUST stay last) ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
