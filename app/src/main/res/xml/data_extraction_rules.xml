<?xml version="1.0" encoding="utf-8"?>
<!--
   Data-extraction rules for Wagmiya (Android 12 / API 31+).
   allowBackup is set to "false" in AndroidManifest.xml, so cloud backup is
   disabled; these rules additionally exclude user data from cloud backup and
   from device-to-device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Firestore persistent disk cache + other app files (PII / pet data) -->
        <exclude domain="file" path="." />
        <!-- Local Room database (pets, vaccinations, medical reports, alerts) -->
        <exclude domain="database" path="." />
        <!-- SharedPreferences that may hold user data / auth state -->
        <exclude domain="sharedpref" path="." />
        <!-- External app storage -->
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
